<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="@color/border" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="@color/accent_deep" /></shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="@color/accent_deep" android:endColor="@color/accent" />
        </shape>
    </item>
</selector>
