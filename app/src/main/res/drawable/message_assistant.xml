<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/assistant_bubble" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
    <item android:width="4dp" android:gravity="start">
        <shape>
            <solid android:color="@color/accent" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</layer-list>
